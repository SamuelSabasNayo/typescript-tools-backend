{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "target": "es6",
        "module": "node16",
        "outDir": "./dist",
        "rootDir": "./src",
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
    },
    "include": ["src/**/*.ts", "*.tsx"],
    "exclude": ["src/umzug.ts", "src/db/migrations/**/*"]
}